# ---- Basico ----------------------------------------------------------------
MARCA=Levent
SITE_URL=https://www.levent.mx
NODE_ENV=development
DATA_DIR=./data

# Contrasena del panel /admin
ADMIN_PASSWORD=cambia-esta-contrasena
SESSION_SECRET=texto-largo-y-aleatorio-de-al-menos-32-caracteres

# La crea Railway sola al agregar el plugin de PostgreSQL
DATABASE_URL=postgres://usuario:clave@localhost:5432/levent

# ---- Meta Ads --------------------------------------------------------------
# Administrador de eventos > tu conjunto de datos > el numero grande de arriba
META_PIXEL_ID=

# Mismo lugar > Configuracion > Conversions API > Generar token de acceso.
# Es secreto: da permiso de escribir eventos en tu Pixel. Nunca va en el HTML.
META_ACCESS_TOKEN=

# Solo mientras pruebas. Administrador de eventos > Probar eventos > copia el
# codigo TESTxxxxx. Con esto puesto, los eventos NO cuentan para la campana.
# BORRALO antes de encender los anuncios de verdad.
META_TEST_EVENT_CODE=

# Cuanto vale un lead para ti (en MXN). Opcional: si lo pones, Meta puede
# optimizar hacia valor y no solo hacia volumen de leads.
META_VALOR_LEAD=

# ---- Pagos (Mercado Pago) --------------------------------------------------
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Ponlo en true SOLO mientras pruebas con credenciales de prueba
MP_SANDBOX=false
MONEDA=MXN

# ---- Aviso de leads por correo (opcional) ----------------------------------
RESEND_API_KEY=
RESEND_FROM=Levent <onboarding@resend.dev>
LEADS_EMAIL_TO=
