# Contrasena para entrar a la app. Cambiala por una tuya.
APP_PASSWORD=cambia-esta-contrasena

# Cadena secreta para firmar la sesion. Pon cualquier texto largo al azar.
SESSION_SECRET=cambia-este-texto-por-uno-largo-y-al-azar

# Llave de Resend para enviar los correos. Se saca en resend.com
RESEND_API_KEY=

# Remitente. El dominio debe estar verificado en Resend.
RESEND_FROM=Endulcora <reconocimientos@envios.endulcora.com>

# Carpeta donde se guardan los datos y los archivos subidos.
DATA_DIR=./datos

# Puerto local.
PORT=3100
