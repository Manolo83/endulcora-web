# Copia este archivo a .env para desarrollo local (nunca subas .env real a GitHub)

# Puerto local (Railway define PORT automaticamente en produccion)
PORT=3000

# Contrasena del panel de administracion (/admin). Cambiala por una fuerte.
ADMIN_PASSWORD=cambia-esta-clave

# Alternativa mas segura: un hash bcrypt de la contrasena en vez de texto plano.
# Genera uno con: node -e "console.log(require('bcryptjs').hashSync('tu-clave', 10))"
# Si defines ADMIN_PASSWORD_HASH, tiene prioridad sobre ADMIN_PASSWORD.
# ADMIN_PASSWORD_HASH=

# Clave para firmar la cookie de sesion del admin. Usa un texto largo y aleatorio.
SESSION_SECRET=cambia-esta-clave-tambien

# Carpeta donde se guardan los datos (anuncios/galeria) y los archivos subidos.
# En Railway, apunta esto a un Volume persistente, por ejemplo: /data
DATA_DIR=./data

# URL publica del sitio (sin / al final). Se usa para construir los enlaces
# de regreso y el webhook de Mercado Pago.
SITE_URL=https://www.endulcora.com

# Credenciales de Mercado Pago (Developers > Tu app > Credenciales).
# Usa las de "Prueba" mientras pruebas, y cambia a las "Productivas" para cobrar de verdad.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# Envio de correos de confirmacion de compra (resend.com). Sin esta variable,
# los pedidos se siguen aprobando normal, pero el correo automatico no se envia
# (tienes que entregar manualmente desde /admin > Ventas, como antes).
RESEND_API_KEY=
# Remitente que ven tus clientes. Mientras no verifiques tu dominio en Resend,
# usa el valor de prueba: "Endulcora <onboarding@resend.dev>"
RESEND_FROM=Endulcora <onboarding@resend.dev>

NODE_ENV=development
