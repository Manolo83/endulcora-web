# Copia este archivo a .env para desarrollo local (nunca subas .env real a GitHub)

# Puerto local (Railway define PORT automaticamente en produccion)
PORT=3000

# Contrasena del panel de administracion (/admin). Cambiala por una fuerte.
ADMIN_PASSWORD=cambia-esta-clave

# Alternativa mas segura: un hash bcrypt de la contrasena en vez de texto plano.
# Genera uno con: node -e "console.log(require('bcryptjs').hashSync('tu-clave', 10))"
# Si defines ADMIN_PASSWORD_HASH, tiene prioridad sobre ADMIN_PASSWORD.
# ADMIN_PASSWORD_HASH=

# Clave para firmar la cookie de sesion del admin. Usa un texto largo y aleatorio.
SESSION_SECRET=cambia-esta-clave-tambien

# Base de datos (obligatoria). En Railway, agrega el plugin de PostgreSQL
# (New > Database > PostgreSQL) y esta variable se crea sola.
# En local, usa una URL de un Postgres que tengas corriendo, por ejemplo:
# postgres://postgres:tu-clave@localhost:5432/endulcora
DATABASE_URL=

# Carpeta donde se guardan los archivos subidos (fotos, PDFs). En Railway,
# apunta esto a un Volume, por ejemplo: /data
DATA_DIR=./data

# URL publica del sitio (sin / al final). Se usa para construir los enlaces
# de regreso y el webhook de Mercado Pago.
SITE_URL=https://www.endulcora.com

# Credenciales de Mercado Pago (Developers > Tu app > Credenciales).
# Usa las de "Prueba" mientras pruebas, y cambia a las "Productivas" para cobrar de verdad.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Ponla en "true" SOLO mientras MP_ACCESS_TOKEN/MP_PUBLIC_KEY sean las de
# "Prueba", para que el checkout te mande al ambiente de pruebas de Mercado
# Pago en vez del real. Bórrala o ponla en "false" para cobrar de verdad.
MP_SANDBOX=false

# Envio de correos de confirmacion de compra (resend.com). Sin esta variable,
# los pedidos se siguen aprobando normal, pero el correo automatico no se envia
# (tienes que entregar manualmente desde /admin > Ventas, como antes).
RESEND_API_KEY=
# Remitente que ven tus clientes. Mientras no verifiques tu dominio en Resend,
# usa el valor de prueba: "Endulcora <onboarding@resend.dev>"
RESEND_FROM=Endulcora <onboarding@resend.dev>

# Asistente de IA (burbuja de chat del sitio). Consigue una clave gratis en
# aistudio.google.com (Get API key) - no requiere tarjeta para el nivel
# gratuito. Sin esta variable, la burbuja del asistente sigue apareciendo
# pero responde que todavia no esta activado.
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Campanas de Meta Ads (npm run ads:crenef)
# ---------------------------------------------------------------------------
# Token con permiso ads_management para crear las campanas. Sacalo en
# developers.facebook.com > Herramientas > Explorador de la API Graph:
# elige tu app, pide el permiso ads_management y genera el token.
# Solo se usa desde tu maquina al correr el script; el sitio no lo necesita.
META_ADS_TOKEN=

# Version de la Graph API. Solo cambiala si Meta deja de soportar esta.
META_GRAPH_VERSION=v21.0

NODE_ENV=development
